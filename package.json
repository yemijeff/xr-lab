{
  "name": "xr-lab",
  "version": "0.1.0",
  "private": true,
  "description": "XR Lab — Spatial Design Learning, Experimentation & Publishing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:website": "npm run dev --workspace=apps/website",
    "share:dashboard": "npx -y localtunnel --port 3000 --subdomain xrlab-dashboard",
    "share:website": "npx -y localtunnel --port 3001 --subdomain xrlab-website",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "xr",
    "spatial-design",
    "nextjs",
    "portfolio",
    "journal"
  ],
  "author": "Adeyemi Jeff",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
